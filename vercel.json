{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "devCommand": "npm run dev",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "apps/api/src/vercel.ts",
      "installCommand": "npm ci --include=dev --include-workspace-root",
      "buildCommand": "npm run db:generate",
      "devCommand": "npm run dev:backend",
      "functions": {
        "apps/api/src/vercel.ts": {
          "maxDuration": 300,
          "includeFiles": "{packages/database/generated/**,node_modules/@sparticuz/chromium/bin/**}"
        }
      }
    }
  },
  "crons": [
    {
      "path": "/api/internal/process",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": { "service": "web", "path": "/index" }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "web"
      }
    }
  ]
}
