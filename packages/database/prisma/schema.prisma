generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "mysql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(uuid()) @db.Char(36)
 email String @unique @db.VarChar(191)
 passwordHash String @db.VarChar(255)
 sessionVersion Int @default(0)
 googleRefresh String? @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 forms Form[]
 uploads Upload[]
 jobs SubmissionJob[]
 auditLogs AuditLog[]
}
model Form {
 id String @id @default(uuid()) @db.Char(36)
 userId String @db.Char(36)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 title String @db.VarChar(500)
 sourceUrl String @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 schemas FormSchema[]
 @@index([userId,createdAt])
}
model FormSchema {
 id String @id @default(uuid()) @db.Char(36)
 formId String @db.Char(36)
 form Form @relation(fields:[formId],references:[id],onDelete:Cascade)
 version Int
 definition Json
 fingerprint String @db.Char(64)
 createdAt DateTime @default(now())
 questions FormQuestion[]
 templates ExcelTemplate[]
 @@unique([formId,version])
}
model FormQuestion {
 id String @id @default(uuid()) @db.Char(36)
 schemaId String @db.Char(36)
 schema FormSchema @relation(fields:[schemaId],references:[id],onDelete:Cascade)
 externalId String @db.VarChar(191)
 title String @db.Text
 type String @db.VarChar(40)
 required Boolean
 metadata Json
 @@unique([schemaId,externalId])
}
model ExcelTemplate {
 id String @id @default(uuid()) @db.Char(36)
 schemaId String @db.Char(36)
 schema FormSchema @relation(fields:[schemaId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 uploads Upload[]
}
model Upload {
 id String @id @default(uuid()) @db.Char(36)
 userId String @db.Char(36)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 templateId String @db.Char(36)
 template ExcelTemplate @relation(fields:[templateId],references:[id],onDelete:Cascade)
 checksum String @db.Char(64)
 total Int
 valid Int
 invalid Int
 encryptedData String @db.LongText
 createdAt DateTime @default(now())
 job SubmissionJob?
 @@unique([userId,checksum,templateId])
 @@index([createdAt])
}
model SubmissionJob {
 id String @id @default(uuid()) @db.Char(36)
 userId String @db.Char(36)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 uploadId String @unique @db.Char(36)
 upload Upload @relation(fields:[uploadId],references:[id],onDelete:Cascade)
 title String @db.VarChar(500)
 status String @default("QUEUED") @db.VarChar(40)
 reason String? @db.Text
 authorizedAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 records SubmissionRecord[]
 @@index([userId,createdAt])
 @@index([status])
}
model SubmissionRecord {
 id String @id @default(uuid()) @db.Char(36)
 jobId String @db.Char(36)
 job SubmissionJob @relation(fields:[jobId],references:[id],onDelete:Cascade)
 rowNumber Int
 encryptedAnswers String @db.LongText
 status String @default("QUEUED") @db.VarChar(40)
 attemptCount Int @default(0)
 submitIntentAt DateTime?
 submittedAt DateTime?
 error String? @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 attempts SubmissionAttempt[]
 @@unique([jobId,rowNumber])
 @@index([jobId,status])
}
model SubmissionAttempt {
 id String @id @default(uuid()) @db.Char(36)
 recordId String @db.Char(36)
 record SubmissionRecord @relation(fields:[recordId],references:[id],onDelete:Cascade)
 startedAt DateTime @default(now())
 finishedAt DateTime?
 status String @db.VarChar(40)
 error String? @db.Text
 @@index([recordId,startedAt])
}
model AuditLog {
 id String @id @default(uuid()) @db.Char(36)
 userId String @db.Char(36)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 action String @db.VarChar(80)
 entityId String? @db.Char(36)
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}
