NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/formflow
# MongoDB polling needs no Redis hosting. Set redis only to use the optional BullMQ worker.
QUEUE_BACKEND=mongodb
REDIS_URL=redis://localhost:6379
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_KEY=replace-with-64-hex-characters
MAX_UPLOAD_MB=10
MAX_ROWS=2000
RETENTION_DAYS=30
WORKER_CONCURRENCY=1
RECORD_DELAY_MS=3000
# OAuth optional; enable Google Forms API and register this callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
# Generate a separate random secret for Vercel's scheduled worker endpoint.
CRON_SECRET=

API_PROXY_URL=http://127.0.0.1:4000
