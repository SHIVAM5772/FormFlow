{
  "name": "formflow-automation-nextjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "setup:env": "node scripts/init-env.mjs",
    "dev": "concurrently -k -n api,next \"tsx watch apps/api/src/server.ts\" \"next dev apps/web --hostname 127.0.0.1 --port 3000 --webpack\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3000 --webpack",
    "worker": "tsx workers/submission-worker/src/index.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json && node scripts/copy-prisma-client.mjs",
    "build:web": "next build apps/web --webpack",
    "typecheck": "next typegen apps/web && tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "npm run db:push",
    "db:push": "prisma db push --skip-generate --schema packages/database/prisma/schema.prisma",
    "db:deploy": "npm run db:push",
    "user:create": "tsx scripts/create-user.ts",
    "retention": "tsx scripts/retention.ts",
    "test:services": "vitest run --config vitest.services.config.ts",
    "test:mongodb": "node scripts/test-mongodb.mjs",
    "test:services:local": "node scripts/test-services-local.mjs",
    "verify:proxy": "node scripts/verify-next-proxy.mjs",
    "start:web": "next start apps/web --hostname 127.0.0.1 --port 3000",
    "dev:vercel": "node scripts/vercel-dev.mjs",
    "dev:backend": "tsx watch apps/api/src/server.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.0",
    "@sparticuz/chromium": "141.0.0",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "next": "16.4.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "playwright": "1.56.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.63.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
